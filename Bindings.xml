	<Binding name="CLICK ApothecaUtil_leatherworking:LeftButton" category="Apotheca"/>
	<Binding name="CLICK ApothecaUtil_tailoring:LeftButton" category="Apotheca"/>
	<Binding name="CLICK ApothecaUtil_smelting:LeftButton" category="Apotheca"/>
	<Binding name="CLICK ApothecaUtil_poisons:LeftButton" category="Apotheca"/>
